{
  "plugins": [
    {
      "manifest": {
        "plugin_id": "ironicbadger.network-access.tailscale",
        "version": "0.2.2",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "network_access_provider.v1",
            "id": "tailscale",
            "display_name": "Tailscale",
            "network_access_provider": {
              "provider": "tailscale",
              "display_name": "Tailscale"
            }
          },
          {
            "type": "auth_provider.v1",
            "id": "tailscale",
            "display_name": "Tailscale",
            "description": "Sign in as the owner of the device a request came from over Tailscale.",
            "metadata": {
              "display_name": "Tailscale"
            },
            "auth_modes": [
              "network"
            ]
          }
        ],
        "global_config_schema": [
          {
            "key": "tailscale",
            "title": "Tailscale",
            "description": "Enrollment settings shared by all hosts. Each host retains its own node identity.",
            "json_schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"hostname_prefix\":{\"type\":\"string\",\"pattern\":\"^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$\",\"default\":\"silo\"},\"auth_key\":{\"type\":\"string\",\"writeOnly\":true},\"tags\":{\"type\":\"string\",\"default\":\"\"},\"funnel\":{\"type\":\"boolean\",\"default\":false,\"deprecated\":true,\"description\":\"Removed; ignored.\"},\"sign_in_access\":{\"type\":\"string\",\"enum\":[\"anyone\",\"policy\"],\"default\":\"anyone\"},\"subnet_routers\":{\"type\":\"string\",\"enum\":[\"allow\",\"refuse\"],\"default\":\"allow\"},\"discovery\":{\"type\":\"string\",\"enum\":[\"on\",\"off\"],\"default\":\"on\"}}}",
            "admin_form": {
              "fields": [
                {
                  "key": "hostname_prefix",
                  "label": "Hostname",
                  "description": "The API host uses this exact hostname. Proxy nodes use \u003chostname\u003e-proxy-\u003cnode id\u003e to keep each node distinct.",
                  "control": 1,
                  "default_value": "silo"
                },
                {
                  "key": "auth_key",
                  "label": "Auth key",
                  "description": "Optional Tailscale auth key. Use a reusable key for multiple hosts; leave empty for interactive enrollment.",
                  "control": 3,
                  "secret": true
                },
                {
                  "key": "tags",
                  "label": "Tags",
                  "description": "Optional comma-separated tags, for example tag:silo. Tags must be authorized by your tailnet policy or auth key. Applies to the API host and all proxies.",
                  "control": 1
                },
                {
                  "key": "sign_in_access",
                  "label": "Who can sign in",
                  "description": "Who may sign in to Silo with their Tailscale identity once Tailscale is turned on under Settings \u003e Sign-in. Either way, a siloserver.org/cap/silo grant with {\"role\":\"admin\"} or {\"role\":\"user\"} sets the person's Silo role.",
                  "control": 6,
                  "default_value": "anyone",
                  "options": [
                    {
                      "value": "anyone",
                      "label": "Anyone who can reach Silo over Tailscale",
                      "description": "Every untagged device that reaches this server, including people you share it with."
                    },
                    {
                      "value": "policy",
                      "label": "Only people granted siloserver.org/cap/silo",
                      "description": "A grant in your tailnet policy decides who may sign in and with which role."
                    }
                  ]
                },
                {
                  "key": "subnet_routers",
                  "label": "Subnet routers",
                  "description": "Whether devices that route a subnet into the tailnet can sign in with their Tailscale identity. Exit nodes are not affected.",
                  "control": 6,
                  "default_value": "allow",
                  "options": [
                    {
                      "value": "allow",
                      "label": "Can sign in",
                      "description": "A subnet router signs in as its owner, like any other device. Machines on the LAN behind it keep their own addresses and get no Tailscale identity."
                    },
                    {
                      "value": "refuse",
                      "label": "Cannot sign in",
                      "description": "For tailnets where a router rewrites forwarded LAN traffic to its own Tailscale address, which would let everyone behind it sign in as its owner."
                    }
                  ]
                },
                {
                  "key": "discovery",
                  "label": "Discovery",
                  "description": "Whether Silo apps on the tailnet can find this server by its short hostname.",
                  "control": 6,
                  "default_value": "on",
                  "options": [
                    {
                      "value": "on",
                      "label": "On",
                      "description": "The API host also answers plain HTTP on port 80 with a redirect to its HTTPS address, so Silo apps on the tailnet can find it by its short name. Nothing else is served on port 80."
                    },
                    {
                      "value": "off",
                      "label": "Off",
                      "description": "Port 80 stays closed. People enter the full HTTPS address."
                    }
                  ]
                }
              ]
            }
          }
        ],
        "presentation": {
          "display_name": "Tailscale",
          "summary": "Reach Silo through your tailnet without opening public ports.",
          "description_markdown": "Runs a separate Tailscale node on the API host and every proxy. Exposes the native, Jellyfin and Audiobookshelf listeners over HTTPS on your tailnet only. The API host also answers plain HTTP on port 80 with a redirect to its HTTPS address, so Silo apps can find it by name; turn this off under Discovery. Optionally, people whose device reaches Silo over Tailscale sign in as the device's owner with no password; your tailnet policy decides who can and with which role.",
          "setup_markdown": "Requires Silo's network-access plugin support, one API host, and MagicDNS plus HTTPS certificates enabled in Tailscale. Save an optional reusable auth key for automatic enrollment across proxies, then select Connect in Settings \u003e Network Access. Otherwise use the authorization URL shown for each host. To let people sign in with their Tailscale identity, turn on Tailscale under Settings \u003e Sign-in \u003e Network sign-in.",
          "homepage_url": "https://github.com/Silo-Community/silo-plugin-tailscale",
          "source_url": "https://github.com/Silo-Community/silo-plugin-tailscale",
          "support_url": "https://github.com/Silo-Community/silo-plugin-tailscale/issues",
          "changelog_url": "https://github.com/Silo-Community/silo-plugin-tailscale/releases",
          "publisher_name": "ironicbadger",
          "publisher_url": "https://github.com/ironicbadger",
          "license_spdx": "MIT"
        }
      },
      "repo_url": "https://github.com/Silo-Community/silo-plugin-tailscale",
      "checksums_url": "https://github.com/Silo-Community/silo-plugin-tailscale/releases/download/v0.2.2/checksums.txt",
      "binaries": {
        "darwin/arm64": {
          "url": "https://github.com/Silo-Community/silo-plugin-tailscale/releases/download/v0.2.2/plugin-darwin-arm64"
        },
        "linux/amd64": {
          "url": "https://github.com/Silo-Community/silo-plugin-tailscale/releases/download/v0.2.2/plugin-linux-amd64"
        },
        "linux/arm64": {
          "url": "https://github.com/Silo-Community/silo-plugin-tailscale/releases/download/v0.2.2/plugin-linux-arm64"
        }
      },
      "approval": {
        "approved_at": "2026-09-22",
        "review_url": "https://github.com/Silo-Community/silo-plugins/issues/8"
      }
    },
    {
      "manifest": {
        "plugin_id": "silo.requests.arr",
        "version": "0.1.9",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "request_router.v1",
            "id": "arr",
            "display_name": "Sonarr / Radarr",
            "description": "Fulfills movie/series requests against multi-instance Sonarr/Radarr.",
            "config_schema": [
              {
                "key": "connection",
                "title": "Connection",
                "json_schema": "{\"type\":\"object\",\"properties\":{\"service_kind\":{\"type\":\"string\"},\"root_folder\":{\"type\":\"string\"},\"quality_profile_id\":{\"type\":\"integer\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}},\"is_default\":{\"type\":\"boolean\"},\"is_4k\":{\"type\":\"boolean\"},\"is_default_4k\":{\"type\":\"boolean\"},\"search_on_add\":{\"type\":\"boolean\"},\"monitor\":{\"type\":\"string\"},\"minimum_availability\":{\"type\":\"string\"},\"series_type\":{\"type\":\"string\"},\"season_folder\":{\"type\":\"boolean\"},\"metadata_language\":{\"type\":\"integer\"},\"anime_enabled\":{\"type\":\"boolean\"},\"anime_root_folder\":{\"type\":\"string\"},\"anime_quality_profile_id\":{\"type\":\"integer\"},\"anime_tags\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}}}",
                "admin_form": {
                  "fields": [
                    {
                      "key": "service_kind",
                      "label": "Service",
                      "description": "Detected from the server when it connects.",
                      "control": 6,
                      "required": true,
                      "options": [
                        {
                          "value": "radarr",
                          "label": "Radarr (movies)"
                        },
                        {
                          "value": "sonarr",
                          "label": "Sonarr (series)"
                        }
                      ]
                    },
                    {
                      "key": "root_folder",
                      "label": "Root folder",
                      "control": 6,
                      "dynamic_options": true
                    },
                    {
                      "key": "quality_profile_id",
                      "label": "Quality profile",
                      "control": 6,
                      "required": true,
                      "dynamic_options": true
                    },
                    {
                      "key": "tags",
                      "label": "Tags",
                      "control": 7,
                      "dynamic_options": true
                    },
                    {
                      "key": "is_default",
                      "label": "Default (HD/1080p)",
                      "control": 5,
                      "exclusive_group_field": "service_kind"
                    },
                    {
                      "key": "is_4k",
                      "label": "4K instance",
                      "control": 5
                    },
                    {
                      "key": "is_default_4k",
                      "label": "Default 4K (2160p)",
                      "control": 5,
                      "show_when": [
                        {
                          "field": "is_4k",
                          "equals": [
                            "true"
                          ]
                        }
                      ],
                      "exclusive_group_field": "service_kind"
                    },
                    {
                      "key": "search_on_add",
                      "label": "Search on add",
                      "control": 5,
                      "default_value": true
                    },
                    {
                      "key": "monitor",
                      "label": "Monitor",
                      "description": "Episodes Sonarr monitors when a series is added. With Search on add on, Sonarr immediately searches every monitored episode that has aired, so All episodes searches a long-running show's entire back catalog. A request for particular seasons monitors and searches only those seasons instead.",
                      "control": 6,
                      "default_value": "all",
                      "options": [
                        {
                          "value": "all",
                          "label": "All episodes"
                        },
                        {
                          "value": "future",
                          "label": "Future episodes"
                        },
                        {
                          "value": "recent",
                          "label": "Recent episodes (last 90 days and future)"
                        },
                        {
                          "value": "lastSeason",
                          "label": "Last season"
                        },
                        {
                          "value": "firstSeason",
                          "label": "First season"
                        },
                        {
                          "value": "pilot",
                          "label": "Pilot episode"
                        }
                      ],
                      "show_when": [
                        {
                          "field": "service_kind",
                          "equals": [
                            "sonarr"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "minimum_availability",
                      "label": "Minimum availability",
                      "control": 6,
                      "default_value": "released",
                      "options": [
                        {
                          "value": "announced",
                          "label": "Announced"
                        },
                        {
                          "value": "inCinemas",
                          "label": "In cinemas"
                        },
                        {
                          "value": "released",
                          "label": "Released"
                        }
                      ],
                      "show_when": [
                        {
                          "field": "service_kind",
                          "equals": [
                            "radarr"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "series_type",
                      "label": "Series type",
                      "control": 6,
                      "default_value": "standard",
                      "options": [
                        {
                          "value": "standard",
                          "label": "Standard"
                        },
                        {
                          "value": "daily",
                          "label": "Daily"
                        },
                        {
                          "value": "anime",
                          "label": "Anime"
                        }
                      ],
                      "show_when": [
                        {
                          "field": "service_kind",
                          "equals": [
                            "sonarr"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "season_folder",
                      "label": "Season folder",
                      "control": 5,
                      "default_value": true,
                      "show_when": [
                        {
                          "field": "service_kind",
                          "equals": [
                            "sonarr"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "metadata_language",
                      "label": "Metadata language",
                      "description": "The language Sonarr fetches a new series' titles and descriptions in. Sonarr v5 and later; Sonarr v4 uses English.",
                      "control": 6,
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "service_kind",
                          "equals": [
                            "sonarr"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "anime_enabled",
                      "label": "Enable anime overrides",
                      "control": 5
                    },
                    {
                      "key": "anime_root_folder",
                      "label": "Anime root folder",
                      "control": 6,
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "anime_enabled",
                          "equals": [
                            "true"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "anime_quality_profile_id",
                      "label": "Anime quality profile",
                      "control": 6,
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "anime_enabled",
                          "equals": [
                            "true"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "anime_tags",
                      "label": "Anime tags",
                      "control": 7,
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "anime_enabled",
                          "equals": [
                            "true"
                          ]
                        }
                      ]
                    }
                  ],
                  "submit_label": "Save connection",
                  "sections": [
                    {
                      "key": "library",
                      "title": "Library",
                      "collapsible": true,
                      "collapsed_default": true,
                      "field_keys": [
                        "service_kind",
                        "root_folder",
                        "quality_profile_id",
                        "tags",
                        "is_default",
                        "is_4k",
                        "is_default_4k",
                        "search_on_add",
                        "monitor",
                        "minimum_availability",
                        "series_type",
                        "season_folder",
                        "metadata_language"
                      ]
                    },
                    {
                      "key": "anime",
                      "title": "Anime overrides",
                      "field_keys": [
                        "anime_enabled",
                        "anime_root_folder",
                        "anime_quality_profile_id",
                        "anime_tags"
                      ]
                    }
                  ]
                }
              }
            ],
            "request_router": {
              "supports_seasons": true,
              "reports_download_progress": true
            }
          }
        ],
        "presentation": {
          "display_name": "Sonarr \u0026 Radarr Requests",
          "summary": "Route movie and series requests to one or more Sonarr and Radarr instances.",
          "description_markdown": "Fulfills approved Silo requests directly through Sonarr and Radarr. Multiple connections can cover HD and 4K libraries, different root folders and quality profiles, tags, search behavior, and dedicated anime overrides.",
          "setup_markdown": "Install the plugin, then add Sonarr and Radarr connections in Silo with each service URL and API key. Configure the root folder, quality profile, tags, default and 4K roles, and any anime overrides for each connection. The plugin is stateless; Silo supplies credentials for every request.",
          "homepage_url": "https://github.com/Silo-Community/silo-plugins-requests-arr",
          "source_url": "https://github.com/Silo-Community/silo-plugins-requests-arr",
          "support_url": "https://github.com/Silo-Community/silo-plugins-requests-arr/issues",
          "changelog_url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases",
          "publisher_name": "Silo Community",
          "publisher_url": "https://github.com/Silo-Community",
          "license_spdx": "AGPL-3.0-only"
        }
      },
      "repo_url": "https://github.com/Silo-Community/silo-plugins-requests-arr",
      "checksums_url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases/download/v0.1.9/checksums.txt",
      "binaries": {
        "darwin/arm64": {
          "url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases/download/v0.1.9/plugin-darwin-arm64"
        },
        "linux/amd64": {
          "url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases/download/v0.1.9/plugin-linux-amd64"
        },
        "linux/arm64": {
          "url": "https://github.com/Silo-Community/silo-plugins-requests-arr/releases/download/v0.1.9/plugin-linux-arm64"
        }
      },
      "approval": {
        "approved_at": "2026-07-09",
        "review_url": "https://github.com/Silo-Community/silo-plugins/issues/2"
      }
    },
    {
      "manifest": {
        "plugin_id": "silo.requests.seerr",
        "version": "0.2.1",
        "silo_api_version": "v1",
        "supported_platforms": [
          {
            "os": "linux",
            "arch": "amd64"
          },
          {
            "os": "linux",
            "arch": "arm64"
          },
          {
            "os": "darwin",
            "arch": "arm64"
          }
        ],
        "capabilities": [
          {
            "type": "request_router.v1",
            "id": "seerr",
            "display_name": "Seerr",
            "description": "Fulfill content requests through a Seerr (Overseerr/Jellyseerr) instance.",
            "config_schema": [
              {
                "key": "connection",
                "title": "Seerr",
                "json_schema": "{\"type\":\"object\",\"properties\":{\"supports_4k\":{\"type\":\"boolean\"},\"requester_mode\":{\"type\":\"string\"},\"auto_approve\":{\"type\":\"boolean\"},\"require_mapped_user\":{\"type\":\"boolean\"},\"radarr_server_id\":{\"type\":\"string\"},\"radarr_4k_server_id\":{\"type\":\"string\"},\"sonarr_server_id\":{\"type\":\"string\"},\"sonarr_4k_server_id\":{\"type\":\"string\"}}}",
                "admin_form": {
                  "fields": [
                    {
                      "key": "supports_4k",
                      "label": "This Seerr handles 4K requests",
                      "description": "Enable only if the Seerr instance has a 4K Sonarr/Radarr configured. When off, 2160p requests are not sent to this connection.",
                      "control": 5,
                      "default_value": false
                    },
                    {
                      "key": "requester_mode",
                      "label": "Attribute requests to",
                      "description": "Admin user: all requests come from the API-key owner (auto-approved). Map to Silo users: attribute each request to the Seerr user matching the requester's email (created if missing).",
                      "control": 6,
                      "default_value": "admin",
                      "options": [
                        {
                          "value": "admin",
                          "label": "Admin user (API key owner)"
                        },
                        {
                          "value": "mapped",
                          "label": "Map to Silo users"
                        }
                      ]
                    },
                    {
                      "key": "auto_approve",
                      "label": "Auto-approve requests",
                      "description": "Mapped users' requests are auto-approved. Off: they land in Seerr's per-user approval queue.",
                      "control": 5,
                      "default_value": true,
                      "show_when": [
                        {
                          "field": "requester_mode",
                          "equals": [
                            "mapped"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "require_mapped_user",
                      "label": "Fail the request if the user can't be mapped",
                      "description": "On: a request whose Silo user can't be matched/created on Seerr fails instead of being submitted under the admin.",
                      "control": 5,
                      "default_value": false,
                      "show_when": [
                        {
                          "field": "requester_mode",
                          "equals": [
                            "mapped"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "radarr_server_id",
                      "label": "Radarr server (movies)",
                      "description": "The Seerr Radarr server that HD movie requests go to. Ignored for series. Seerr default uses whichever server Seerr marks as default. A chosen server gets its own quality profile, root folder and tags from Seerr. Silo request routes can override this per rule.",
                      "control": 6,
                      "default_value": "default",
                      "options": [
                        {
                          "value": "default",
                          "label": "Seerr default"
                        }
                      ],
                      "dynamic_options": true
                    },
                    {
                      "key": "radarr_4k_server_id",
                      "label": "Radarr 4K server (movies)",
                      "description": "The Seerr 4K Radarr server that 4K movie requests go to. Ignored for series. Seerr default uses whichever server Seerr marks as default. A chosen server gets its own quality profile, root folder and tags from Seerr. Silo request routes can override this per rule.",
                      "control": 6,
                      "default_value": "default",
                      "options": [
                        {
                          "value": "default",
                          "label": "Seerr default"
                        }
                      ],
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "supports_4k",
                          "equals": [
                            "true"
                          ]
                        }
                      ]
                    },
                    {
                      "key": "sonarr_server_id",
                      "label": "Sonarr server (series)",
                      "description": "The Seerr Sonarr server that HD series requests go to. Ignored for movies. Seerr default uses whichever server Seerr marks as default. A chosen server gets its own quality profile, root folder and tags from Seerr. Silo request routes can override this per rule.",
                      "control": 6,
                      "default_value": "default",
                      "options": [
                        {
                          "value": "default",
                          "label": "Seerr default"
                        }
                      ],
                      "dynamic_options": true
                    },
                    {
                      "key": "sonarr_4k_server_id",
                      "label": "Sonarr 4K server (series)",
                      "description": "The Seerr 4K Sonarr server that 4K series requests go to. Ignored for movies. Seerr default uses whichever server Seerr marks as default. A chosen server gets its own quality profile, root folder and tags from Seerr. Silo request routes can override this per rule.",
                      "control": 6,
                      "default_value": "default",
                      "options": [
                        {
                          "value": "default",
                          "label": "Seerr default"
                        }
                      ],
                      "dynamic_options": true,
                      "show_when": [
                        {
                          "field": "supports_4k",
                          "equals": [
                            "true"
                          ]
                        }
                      ]
                    }
                  ],
                  "submit_label": "Save connection",
                  "sections": [
                    {
                      "key": "connection",
                      "title": "Seerr",
                      "field_keys": [
                        "supports_4k",
                        "requester_mode",
                        "auto_approve",
                        "require_mapped_user"
                      ]
                    },
                    {
                      "key": "servers",
                      "title": "Radarr and Sonarr servers",
                      "description": "Pick which of Seerr's Radarr and Sonarr servers each request goes to. Radarr fields apply to movies and Sonarr fields to series; leave a field on Seerr default to keep Seerr's own choice. In a Silo routing rule, set only the fields for that rule's media type.",
                      "collapsible": true,
                      "collapsed_default": true,
                      "field_keys": [
                        "radarr_server_id",
                        "radarr_4k_server_id",
                        "sonarr_server_id",
                        "sonarr_4k_server_id"
                      ]
                    }
                  ]
                }
              }
            ],
            "request_router": {
              "reports_download_progress": true
            }
          }
        ],
        "presentation": {
          "display_name": "Seerr Requests",
          "summary": "Submit Silo movie and series requests through a Seerr-compatible server.",
          "description_markdown": "Connects Silo to Seerr, including Jellyseerr and Overseerr-compatible deployments. Seerr continues to manage its own Sonarr and Radarr services while the plugin maps Silo request identities, HD and 4K intent, and request status.",
